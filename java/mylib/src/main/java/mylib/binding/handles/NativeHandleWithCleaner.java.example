/*
 * NativeHandle with Cleaner implementation reference
 * 
 * A drop-in replacement for NativeHandle
 * Rename NativeHandlerWithCleaner to NativeHandler, and you're good to go
 * 
 * Cleaner requires Java 9+
 */

package mylib.binding.handles;

import java.util.function.LongToIntFunction;
import java.lang.ref.Cleaner;
import mylib.internal.StatusHelper;

public abstract class NativeHandleWithCleaner {

    private static final class State implements Runnable {

        private final AtomicLong native_pointer;
        private final LongToIntFunction releaser;

        State(long value, LongToIntFunction releaser) {
            this.native_pointer = new AtomicLong(value);
            this.releaser = releaser;
        }

        public final long value() {
            long ptr_value = native_pointer.get();
            if (ptr_value == 0)
                throw new IllegalStateException("Handle is closed");
            return ptr_value;
        }

        public final boolean isNull() {
            return native_pointer.get() == 0;
        }

        @Override
        public void run() {
            if (releaser == null)       // non-owning handle
                return;

            long pointer_to_free = native_pointer.getAndSet(0);

            if (pointer_to_free != 0)
                StatusHelper.check(releaser.applyAsInt(pointer_to_free));
        }
    }

    private static final Cleaner CLEANER = Cleaner.create();
    private final Cleaner.Cleanable cleanable;
    private final State state;

    protected NativeHandleWithCleaner(long value, LongToIntFunction releaser) {
        this.state = new State(value, releaser);
        this.cleanable = CLEANER.register(this, state);
    }

    protected NativeHandlerWithCleaner(long value) {
        this(value, null);
    }

    public final void close() {
        cleanable.clean();
    }

    public final long value() {
        return state.value();
    }

    public final boolean isNull() {
        return state.isNull();
    }
}
